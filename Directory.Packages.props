<Project>
  <!-- Enable Central Package Management (CPM) -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Runtime packages (src/*) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <!-- Serilog packages for Loggings -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!-- Test packages (tests/*) -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.1" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Serilog.Sinks.InMemory" Version="2.0.0" />
  </ItemGroup>

  <!-- Build tooling (all projects) -->
  <ItemGroup>
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
  </ItemGroup>
</Project>
